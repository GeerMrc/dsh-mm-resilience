{
  "name": "dsh-mm-resilience",
  "version": "0.0.1",
  "private": true,
  "description": "图片解析归档复用：每张图片首次入会时解析一次并归档打标，此后所有请求零图片字节重发，从根源避免多模态故障卡死会话；像素上限与每条消息解析（描述）上限接管官方默认值（可调、可恢复默认），多图解析并行数可配；原图按需回看（mm_view_image）。",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./client": {
      "default": "./client/index.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "test": "node --loader ./tests/stub-css-loader.mjs --test tests/",
    "pretest": "tsc node_modules/@deepseek-ai/dsh-client-ui-primitives/src/settings-form/form-model.ts --outDir .compiled --module es2022 --target es2022 --moduleResolution bundler --skipLibCheck"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4 <4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "src",
    "client",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeerMrc/dsh-mm-resilience.git"
  },
  "bugs": {
    "url": "https://github.com/GeerMrc/dsh-mm-resilience/issues"
  },
  "homepage": "https://github.com/GeerMrc/dsh-mm-resilience#readme"
}
